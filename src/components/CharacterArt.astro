---
/**
 * Renders a character. Uses real art from src/assets/art/<class>/ when it
 * exists (idle required; hover / selected optional) and the designed
 * placeholder otherwise. State swaps are driven by CSS on the parent slot
 * (see select.css), so there is no per-character logic here.
 */
import { Image } from "astro:assets";
import { characterById, type ClassId } from "@/data/characters";
import { characterArt, characterProps } from "@/lib/assets";
import { CANVAS_W, CANVAS_H } from "../../scripts/art-lib.mjs";
import PlaceholderFigure from "./PlaceholderFigure.astro";

interface Props {
  id: ClassId;
  /** Pixel width to generate for real art. */
  width?: number;
  /** Provide alt text when the art is not decorative. */
  describe?: boolean;
  loading?: "eager" | "lazy";
}
const { id, width = 640, describe = false, loading = "eager" } = Astro.props;
const character = characterById[id];
const idle = characterArt(id, "idle");
const hover = characterArt(id, "hover");
const selected = characterArt(id, "selected");
const alt = describe ? character.artAlt : "";
const props = idle ? characterProps(id) : [];
const VARIANTS = ["bob", "drift", "orbit"] as const;
/**
 * Per-class motion overrides, by prop index (props are ordered largest
 * component first, see prep-art.mjs). Anything not listed here falls back
 * to VARIANTS, cycled by index. Tuned by eye against the actual art:
 *  - oracle's main shard (index 0) and its six orbiting micro-shards
 *    (indices 1-6, extracted separately since they're their own tiny
 *    components) all share one U-shaped swinging arc so the swarm reads as
 *    following the main shard, each just slightly delayed (see timingFor).
 *  - courier's companion robot should read as pacing alongside him.
 *  - archivist's schema runes/hologram should glow brighter at the peak of
 *    their motion, like the lantern is revealing them.
 *  - worldbuilder's world-fragments (indices 0-4; index 5 is excluded, see
 *    below) orbit the character on one shared circle (see orbitDelay below)
 *    instead of the default bob/drift/orbit; their orbit rings + gem flecks
 *    (indices 6-10, one per fragment 0-4) ride that exact same circle,
 *    phase-delayed, so they trail their fragment around the ring instead of
 *    wobbling near it on an unrelated schedule -- the same "shares the
 *    leader's path, phase-offset" trick as oracle's shard swarm. Index 2
 *    (a stone ruin) looks similar to the actual gateway but isn't it -- the
 *    real gateway (with its glowing portal) was never auto-extracted at
 *    all, since it stayed fused to the body in prep-art.mjs's connected-
 *    component pass; it's manually extracted as index 12, but stays
 *    static ("static" below), not part of the orbit -- only its two small
 *    crystal shards (indices 5 and 11) move, a tight local loop right at
 *    the gateway's position (see "gateway-shard" in the CSS below).
 */
const MOTION: Partial<Record<ClassId, string[]>> = {
  oracle: Array(7).fill("shard-arc"),
  courier: ["walk"],
  archivist: Array(6).fill("glow-pulse"),
};
const motionFor = (i: number) => {
  if (id === "worldbuilder") {
    if (i === 5) return "gateway-shard";
    if (i === 11) return "gateway-shard-b";
    if (i === 12) return "static";
    return i < 6 ? "orbit-xy" : "orbit-xy-ebb";
  }
  return MOTION[id]?.[i] ?? VARIANTS[i % VARIANTS.length];
};

/**
 * World-fragments orbit the character on one shared ellipse (CSS
 * offset-path), *not* a true circle -- his pose is too asymmetric (one arm
 * raised and out, the other down and in, a narrow waist) for any circle to
 * both clear his own silhouette and stay within the canvas. Checked this
 * directly: sampling 360 points around a circle at the centroid (below)
 * with the largest radius that still clears the ~5% side margins (22% of
 * the canvas diagonal), 168 of those 360 points -- 47% of the path --
 * land on his own opaque pixels. A circle large enough to clear him
 * entirely needs ~55% radius, which clips well past the canvas edge. An
 * ellipse (orbitRX/orbitRY, independent per axis, each in % of canvas
 * width/height per the CSS ellipse() spec -- not the diagonal formula
 * circle() uses) recentered toward his chest gets that overlap down to
 * 28/360 (7.8%) at the largest size that still clears the margins (found
 * by sampling a grid of centers/sizes and keeping the lowest-overlap
 * combination, then pulling back ~1% from the exact margin for a safety
 * buffer) -- not perfect, but close enough that nothing should visibly sit
 * on top of him for long.
 *
 * Each fragment's starting angle, measured from its *current* hand-placed
 * originPct relative to that center, decides only its *order* around the
 * ellipse, not its exact starting position: delays are then reassigned to
 * evenly spaced angles (360/5 = 72° apart) in that same order. Using the
 * raw measured angles directly, as an earlier version did, packed three
 * fragments within ~120° of each other and the other two within ~35°,
 * leaving two near-empty arcs between them -- which reads as two separate
 * clusters orbiting, each on its own path, rather than five fragments
 * evenly sharing the one path. Evenly spacing them (while keeping their
 * relative order, so nothing crosses another fragment's path) fixes that
 * without an arbitrary snap. */
const ORBIT_T = 26; // seconds per revolution, shared by every fragment + its particle
const orbitCx = 50; // chosen (with orbitRX/orbitRY below) to minimize path-vs-body overlap, not his exact centroid
const orbitCy = 47;
const orbitRX = 44; // % of canvas width
const orbitRY = 41; // % of canvas height
/** Angle of a point relative to the shared circle's center (orbitCx/
 * orbitCy, see the comment above), normalized to [0, 2*PI) so sorting by
 * it gives the true circular order. atan2's raw range is (-PI, PI]; sorting
 * by that directly puts anything just past the +PI/-PI seam (e.g. 181°,
 * which atan2 reports as -179°) at the *start* of the order instead of
 * where it physically sits, scrambling every fragment's assigned angle. */
const angleOf = (originPct: { x: number; y: number }, centerPx: { x: number; y: number }) => {
  const dx = (originPct.x / 100) * CANVAS_W - centerPx.x;
  const dy = (originPct.y / 100) * CANVAS_H - centerPx.y;
  const raw = Math.atan2(dy, dx);
  return raw < 0 ? raw + 2 * Math.PI : raw;
};
let orbitDelay: number[] = [];
if (id === "worldbuilder" && props.length >= 5) {
  const fragments = props.slice(0, 5);
  const centerPx = { x: (orbitCx / 100) * CANVAS_W, y: (orbitCy / 100) * CANVAS_H };
  const angles = fragments.map((p) => angleOf(p.originPct, centerPx));
  const order = angles.map((_, i) => i).sort((a, b) => angles[a] - angles[b]);
  orbitDelay = new Array(fragments.length);
  order.forEach((fragmentIndex, rank) => {
    orbitDelay[fragmentIndex] = -((rank / fragments.length) * ORBIT_T);
  });
}

/**
 * Per-prop animation-duration/delay, in seconds. Default staggers both
 * duration and delay by index so independent props (e.g. archivist's runes)
 * desync from each other. A *positive* delay pushes an element's start
 * later in real time, so it lags the one before it; a negative delay (the
 * default case below) does the opposite, fast-forwarding it ahead -- easy
 * to get backwards.
 *  - oracle's shard swarm needs the same duration for every shard so they
 *    never drift out of phase, with only a small delay step so the
 *    micro-shards read as trailing just behind the main shard.
 *  - archivist's runes share the lantern-glow's exact duration and zero
 *    delay, so every rune illuminates in the same beat as the lantern
 *    rather than drifting in and out of sync with it over time.
 *  - worldbuilder's fragments all share one orbit duration (ORBIT_T) so
 *    they stay locked to the same circle instead of drifting apart over
 *    time; each fragment's delay is its evenly-spaced slot (orbitDelay
 *    above), and its paired particle gets that same delay plus a small
 *    fixed lag so it trails the fragment around the ring. The two gateway
 *    shards (indices 5 and 11) aren't on the big circle at all, so they
 *    just get a short duration and a small stagger between them; the real
 *    gateway (index 12, "static") needs no timing at all.
 */
const timingFor = (i: number) => {
  if (id === "oracle") return { duration: 7, delay: i * 0.18 };
  if (id === "archivist") return { duration: 4.5, delay: 0 };
  if (id === "worldbuilder") {
    if (i === 5) return { duration: 5, delay: 0 };
    if (i === 11) return { duration: 5, delay: 0.5 };
    const f = i < 6 ? i : i - 6;
    const lag = i < 6 ? 0 : 0.5;
    return { duration: ORBIT_T, delay: (orbitDelay[f] ?? 0) + lag };
  }
  return { duration: 4.5 + (i % 4) * 0.8, delay: -(i * 0.6) };
};

/**
 * CSS-only glow (no separate art) positioned over a spot in the idle art
 * itself, for signature items that are held/worn (fused into the body
 * render) rather than a separate floating prop layer:
 *  - archivist's lantern brightens on a continuous loop alongside the runes.
 *  - paladin's sword blade and courier's eye lens each get a brief glint
 *    timed to the slot's breathe animation (see select.css), so they only
 *    glimmer while that slot is current, synced to the same beat as the
 *    figure rising -- i.e. at the top of its path.
 * Rendered as a data-URI SVG <img> with the `.layer` class (not a plain
 * div with percent left/top) so it gets the exact same object-fit: contain
 * / object-position: bottom placement math as the real art -- a div
 * positioned by raw percentage of `.art` doesn't account for the
 * letterboxing object-fit adds when `.art`'s own aspect ratio doesn't
 * match the canvas. x/y/size are in canvas percent (same space as prop
 * originPct) -- eyeballed against each class's idle.png, re-tune if that
 * art changes.
 */
interface Spot {
  x: number;
  y: number;
  size: number;
  stops: { offset: number; color: string; opacity?: number }[];
  /** "jack": a 4-point sparkle (N/E/S/W tips joined by concave arcs pulled
   * toward the center) instead of a plain circle -- used for a glint that
   * should read as a twinkle rather than a glowing orb. */
  shape?: "circle" | "jack";
}
const spotSvg = ({ x, y, size, stops, shape = "circle" }: Spot) => {
  const cx = (x / 100) * CANVAS_W;
  const cy = (y / 100) * CANVAS_H;
  const r = (size / 100) * CANVAS_W;
  const gradientStops = stops.map((s) => `<stop offset="${s.offset}%" stop-color="${s.color}" stop-opacity="${s.opacity ?? 1}"/>`).join("");
  let shapeEl;
  if (shape === "jack") {
    // 4 skinny arms (N/E/S/W): each tip tapers on straight edges to a pair
    // of "shoulder" points near the center, and a concave arc (quadratic,
    // control pulled to the center) joins each arm's shoulder to the
    // next arm's -- that arc is the only curved part, giving a thin cross
    // with pinched, rounded notches rather than a plump 4-point star.
    const thetaRad = (8 * Math.PI) / 180; // arm half-width, in degrees off its axis
    const baseR = r * 0.3; // radius of the shoulder points
    const axes = [-90, 0, 90, 180].map((deg) => (deg * Math.PI) / 180);
    let d = "";
    for (let i = 0; i < 4; i++) {
      const a = axes[i];
      const tip: [number, number] = [r * Math.cos(a), r * Math.sin(a)];
      const shoulderCw: [number, number] = [baseR * Math.cos(a + thetaRad), baseR * Math.sin(a + thetaRad)];
      const nextA = axes[(i + 1) % 4];
      const shoulderCcwNext: [number, number] = [baseR * Math.cos(nextA - thetaRad), baseR * Math.sin(nextA - thetaRad)];
      const nextTip: [number, number] = [r * Math.cos(nextA), r * Math.sin(nextA)];
      if (i === 0) d += `M ${tip[0]},${tip[1]} `;
      d += `L ${shoulderCw[0]},${shoulderCw[1]} Q 0,0 ${shoulderCcwNext[0]},${shoulderCcwNext[1]} L ${nextTip[0]},${nextTip[1]} `;
    }
    d += "Z";
    shapeEl = `<path transform="translate(${cx} ${cy})" d="${d}" fill="url(#g)"/>`;
  } else {
    shapeEl = `<circle cx="${cx}" cy="${cy}" r="${r}" fill="url(#g)"/>`;
  }
  const svg = `<svg xmlns="http://www.w3.org/2000/svg" width="${CANVAS_W}" height="${CANVAS_H}" viewBox="0 0 ${CANVAS_W} ${CANVAS_H}"><defs><radialGradient id="g">${gradientStops}</radialGradient></defs>${shapeEl}</svg>`;
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};

const GLOW: Partial<Record<ClassId, Spot>> = {
  archivist: { x: 73, y: 34, size: 11, stops: [{ offset: 0, color: "#ff8a1f" }, { offset: 70, color: "#ff8a1f", opacity: 0 }] },
};
const glow = GLOW[id];
const GLINT: Partial<Record<ClassId, Spot>> = {
  paladin: {
    x: 14.3,
    y: 71,
    size: 3.4,
    shape: "jack",
    stops: [
      { offset: 0, color: "#ffffff" },
      { offset: 20, color: "#ffffff" },
      { offset: 45, color: "#7fb4e8" },
      { offset: 65, color: "#7fb4e8", opacity: 0 },
    ],
  },
  courier: {
    x: 50.8,
    y: 20.8,
    size: 2.2,
    stops: [
      { offset: 0, color: "#ffffff" },
      { offset: 25, color: "#4dffb3" },
      { offset: 60, color: "#10e08a", opacity: 0 },
    ],
  },
};
const glint = GLINT[id];
/** A larger, fainter bloom around GLINT's sharp core, same spot and timing,
 * so the flash reads as light catching the blade rather than a bright dot
 * sitting on it. */
const GLINT_HALO: Partial<Record<ClassId, Spot>> = {
  paladin: {
    x: 14.3,
    y: 71,
    size: 9,
    stops: [
      { offset: 0, color: "#ffffff", opacity: 0.8 },
      { offset: 35, color: "#7fb4e8", opacity: 0.4 },
      { offset: 100, color: "#7fb4e8", opacity: 0 },
    ],
  },
  courier: {
    x: 50.8,
    y: 20.8,
    size: 5,
    stops: [
      { offset: 0, color: "#ffffff", opacity: 0.7 },
      { offset: 35, color: "#10e08a", opacity: 0.35 },
      { offset: 100, color: "#10e08a", opacity: 0 },
    ],
  },
};
const glintHalo = GLINT_HALO[id];
---

<div class="art" data-has-hover={hover ? "" : undefined} data-has-selected={selected ? "" : undefined}>
  {
    idle ? (
      <>
        <Image class="layer idle" src={idle} alt={alt} width={width} loading={loading} />
        {hover && <Image class="layer hover" src={hover} alt="" width={width} loading="lazy" />}
        {selected && <Image class="layer selected" src={selected} alt="" width={width} loading="lazy" />}
        {glow && (
          <img class="layer lantern-glow" src={spotSvg(glow)} alt="" style={{ transformOrigin: `${glow.x}% ${glow.y}%` }} />
        )}
        {glintHalo && (
          <img class="layer glint-halo" src={spotSvg(glintHalo)} alt="" style={{ transformOrigin: `${glintHalo.x}% ${glintHalo.y}%` }} />
        )}
        {glint && (
          <img class="layer glint-core" src={spotSvg(glint)} alt="" style={{ transformOrigin: `${glint.x}% ${glint.y}%` }} />
        )}
        {props.map((prop, i) => {
          const timing = timingFor(i);
          return (
            <Image
              class={`layer prop prop-${motionFor(i)}`}
              src={prop.image}
              alt=""
              width={width}
              loading="lazy"
              style={{
                transformOrigin: `${prop.originPct.x}% ${prop.originPct.y}%`,
                animationDuration: `${timing.duration}s`,
                animationDelay: `${timing.delay}s`,
              }}
            />
          );
        })}
      </>
    ) : (
      <PlaceholderFigure id={id} label={describe ? character.artAlt : undefined} />
    )
  }
</div>

<style define:vars={{ orbitCx: `${orbitCx}%`, orbitCy: `${orbitCy}%`, orbitRX: `${orbitRX}%`, orbitRY: `${orbitRY}%` }}>
  .art {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: bottom;
    transition: opacity 0.2s;
  }
  .hover,
  .selected {
    opacity: 0;
  }
  :global(li[data-current="true"]) .art[data-has-hover] .idle {
    opacity: 0;
  }
  :global(li[data-current="true"]) .art .hover {
    opacity: 1;
  }
  :global(li[data-selected="true"]) .art[data-has-selected] .idle,
  :global(li[data-selected="true"]) .art[data-has-selected] .hover {
    opacity: 0;
  }
  :global(li[data-selected="true"]) .art .selected {
    opacity: 1;
  }

  /* Free-floating props (see src/lib/assets.ts characterProps): independent,
     looping motion so the art feels alive without needing tweened poses.
     transform-origin is set inline per prop (its own centroid on the shared
     canvas), so rotation pivots on the prop, not the image corner. */
  .prop-bob {
    animation: prop-bob 5s ease-in-out infinite;
  }
  .prop-drift {
    animation: prop-drift 6s ease-in-out infinite;
  }
  .prop-orbit {
    animation: prop-orbit 7s ease-in-out infinite;
  }
  @keyframes prop-bob {
    50% {
      transform: translateY(-2.2%) rotate(2deg);
    }
  }
  @keyframes prop-drift {
    50% {
      transform: translate(1.6%, -1.4%) rotate(-3deg);
    }
  }
  @keyframes prop-orbit {
    25% {
      transform: translate(1.2%, -1.6%) rotate(4deg);
    }
    50% {
      transform: translateY(-2.4%);
    }
    75% {
      transform: translate(-1.2%, -1.6%) rotate(-4deg);
    }
  }

  /* Oracle's shard swarm (main shard + 6 micro-shards, see MOTION above):
     a U-shaped swinging arc -- dips down through the middle between two
     higher side points -- rather than a flat back-and-forth. `alternate`
     reverses smoothly through the same curve each cycle instead of
     snapping back, so it reads as one continuous pendulum swing. Every
     shard shares this exact path, phase-offset by timingFor, so the swarm
     visibly follows the main shard rather than idling in place. */
  .prop-shard-arc {
    animation: prop-shard-arc 7s ease-in-out infinite alternate;
  }
  @keyframes prop-shard-arc {
    0% {
      transform: translate(-3.4%, -0.8%) rotate(-4deg);
    }
    50% {
      transform: translate(0%, 2.6%) rotate(0deg);
    }
    100% {
      transform: translate(3.4%, -0.8%) rotate(4deg);
    }
  }

  /* Worldbuilder's world-fragments (see MOTION/orbitDelay above): a shared
     CSS motion-path ellipse (see the comment on orbitCx/orbitRX above for
     why it's an ellipse and not a circle), centered on --orbitCx/--orbitCy
     with independent radii --orbitRX/--orbitRY (set via define:vars below).
     offset-anchor defaults to the element's transform-origin, which is
     already set inline to each prop's own centroid, so it's the *art's
     visible center* that rides the path, not the canvas corner -- and
     offset-rotate: 0deg keeps the art upright instead of spinning to face
     the direction of travel. Each fragment's animation-delay (see
     timingFor) is its own measured starting angle, so it begins orbiting
     from right where it already sits. Its paired orbit ring/gem fleck
     (the "-ebb" variant) rides the exact same path, phase-delayed, so it
     reads as trailing the fragment around the ring rather than moving on
     an unrelated schedule. Neither rides a scale() pulse -- a growing/
     shrinking object moving along a flat path reads as spiraling toward
     and away from the center, which is explicitly not wanted here (see
     the commit history), even scoped to just the particles.

     Every fragment/particle stays in front of the body for its entire
     loop, same as every other character's props (default stacking order).
     An earlier version sent fragments behind the idle art for half the
     path as a z-axis depth cue -- but passing behind the body occludes
     most of the art, leaving just a sliver visible, which reads as the
     element shrinking and pulling in toward the center. That's the
     opposite of the plain, constant-radius orbit wanted here, so it's
     gone. */
  .prop-orbit-xy,
  .prop-orbit-xy-ebb {
    offset-path: ellipse(var(--orbitRX, 44%) var(--orbitRY, 41%) at var(--orbitCx, 50%) var(--orbitCy, 47%));
    offset-rotate: 0deg;
  }
  .prop-orbit-xy {
    animation: prop-orbit-xy 26s linear infinite;
  }
  @keyframes prop-orbit-xy {
    to {
      offset-distance: 100%;
    }
  }
  .prop-orbit-xy-ebb {
    animation: prop-orbit-xy-ebb 26s linear infinite;
  }
  @keyframes prop-orbit-xy-ebb {
    to {
      offset-distance: 100%;
    }
  }

  /* The real gateway (MOTION index 12) stays put -- no animation at all,
     same as it was before it got pulled out of idle.png. */
  .prop-static {
  }

  /* The gateway's two small shards (MOTION indices 5 and 11, see above):
     a small, local translate() loop (four cardinal points) right at their
     resting position -- which is already the gateway's position, since
     their art was recomposited to sit there (see props.json/prop-prep
     notes). No offset-path, no shared circle: they just hover in place
     next to the static gateway. The "-b" variant is identical except its
     four points are rotated 90° (started one step later in the same
     four-point cycle), so the two shards loop out of phase with each
     other instead of moving in lockstep. */
  .prop-gateway-shard {
    animation: prop-gateway-shard 5s ease-in-out infinite;
  }
  @keyframes prop-gateway-shard {
    0%,
    100% {
      transform: translate(3.75%, 0%);
    }
    25% {
      transform: translate(0%, 2.25%);
    }
    50% {
      transform: translate(-3.75%, 0%);
    }
    75% {
      transform: translate(0%, -2.25%);
    }
  }
  .prop-gateway-shard-b {
    animation: prop-gateway-shard-b 5s ease-in-out infinite;
  }
  @keyframes prop-gateway-shard-b {
    0%,
    100% {
      transform: translate(0%, -2.25%);
    }
    25% {
      transform: translate(3.75%, 0%);
    }
    50% {
      transform: translate(0%, 2.25%);
    }
    75% {
      transform: translate(-3.75%, 0%);
    }
  }

  /* Courier's robot: a quick side-to-side pacing cycle with a little step
     bounce, so it reads as walking alongside him rather than floating. */
  .prop-walk {
    animation: prop-walk 3.6s ease-in-out infinite;
  }
  @keyframes prop-walk {
    0%,
    100% {
      transform: translate(-3%, 0) rotate(-4deg);
    }
    25% {
      transform: translate(-1%, -1.4%) rotate(0deg);
    }
    50% {
      transform: translate(3%, 0) rotate(4deg);
    }
    75% {
      transform: translate(1%, -1.4%) rotate(0deg);
    }
  }

  /* Archivist's hologram/runes: brighten and glow at the peak of the bob,
     like the lantern is revealing them. */
  .prop-glow-pulse {
    animation: prop-glow-pulse 4.5s ease-in-out infinite;
  }
  @keyframes prop-glow-pulse {
    0%,
    100% {
      filter: brightness(1) drop-shadow(0 0 0 transparent);
    }
    50% {
      transform: translateY(-2.6%) rotate(2deg);
      filter: brightness(1.7) drop-shadow(0 0 16px var(--c-glow));
    }
  }

  /* CSS-only glow over a spot in the idle art itself (see GLOW/spotSvg
     above) -- no separate layer exists for the thing being lit, so this
     fakes it with a radial gradient baked into an SVG `.layer` (for
     correct alignment, see the Spot/spotSvg comment above). */
  .lantern-glow {
    filter: blur(14px);
    mix-blend-mode: screen;
    opacity: 0.3;
    animation: lantern-glow-pulse 4.5s ease-in-out infinite;
    pointer-events: none;
  }
  @keyframes lantern-glow-pulse {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.85;
      transform: scale(1.3);
    }
  }

  /* Glint core -- paladin's sword, courier's eye lens (see GLINT above):
     stays invisible until the slot is current, then flashes once per
     breathe cycle in step with it (see [data-current="true"] .slot-figure
     in select.css) rather than running on its own independent loop like
     the other classes' props. */
  .glint-core {
    filter: blur(0.5px);
    mix-blend-mode: screen;
    opacity: 0;
    pointer-events: none;
  }
  :global(li[data-current="true"]) .glint-core {
    animation: glint-pulse 3.6s ease-in-out infinite;
  }
  @keyframes glint-pulse {
    0%,
    80%,
    100% {
      opacity: 0;
    }
    50% {
      opacity: 1;
    }
  }

  /* Larger, fainter bloom around the glint's sharp core (see GLINT_HALO
     above) -- same spot and timing, so the flash reads as light catching
